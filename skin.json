{	

    "Conditions": {
		"Show wallet": {
		"tab": "Global options",
		"description": "Show wallet balance next to username",
		"default": "no",
		"values": {
			"yes": {},
			"no": {
			"TargetCss": {
			"affects": ["^Account", "^Steam$"], "src": "elements/options/hide_wallet.css"
					}
				}
			}
		},
		
		"Corners (beta / bugs possibility)": {
		"tab": "Global options",
		"description": "Sets the strength of corner rounding (does not apply on webkit).",
		"default": "default (5px)",
		"values": {
			"square (0px)": {
			"TargetCss": {
			"affects": [".*"], "src": "elements/options/corners/corner0.css"
					}
				},
			"default (5px)": {
			"TargetCss": {
			"affects": [".*"], "src": "elements/options/corners/corner5.css"
					}
				},
			"rounded (10px)": {
			"TargetCss": {
			"affects": [".*"], "src": "elements/options/corners/corner10.css"
					}
				}
			}
		},
		
		"Hide News container": {
		"tab": "Global options",
		"description": "Hide What's new block in the library",
		"default": "no",
		"values": {
			"no": {},
			"yes": {
			"TargetCss": {
			"affects": ["^Steam$"], "src": "elements/options/hide_news.css"
					}
				}
			}
		},
		
		"Hide Steam text": {
		"tab": "Global options",
		"description": "Hide steam text in top left of the root menu",
		"default": "no",
		"values": {
			"no": {},
			"yes": {
			"TargetCss": {
			"affects": ["^Steam$"], "src": "elements/options/hide_steam_text.css"
					}
				}
			}
		},
		
		"Steam alternative logo": {
		"tab": "Global options",
		"description": "Change the logo of the root menu",
		"default": "yes",
		"values": {
			"no": {},
			"yes": {
			"TargetCss": {
			"affects": ["^Steam$"], "src": "elements/options/steam_alternative_logo.css"
					}
				}
			}
		},
		
		"Compact mod": {
		"tab": "Global options",
		"description": "Filters from the sidebar are removed to save even more space",
		"default": "no",
		"values": {
			"no": {},
			"yes": {
			"TargetCss": {
			"affects": ["^Steam$"], "src": "elements/options/compact_mod.css"
					}
				}
			}
		}
		
	},

	"Steam-WebKit": "webkit.css",
	"UseDefaultPatches": true,

	"author": "SaiyajinK",
	"description": "Dark minimalist skin for Steam",
	"name": "Minimal Dark",
	"version": "3.3.7",

