.friendGroup.offlineFriends .ExpandPlusMinus, .friendGroup.onlineFriends .ExpandPlusMinus, .friendGroup.OtherGamesGroup .ExpandPlusMinus, .friendGroup.taggedGroup .ExpandPlusMinus {
    margin-right: 30px !important;
}

.friendGroup.OtherGamesGroup .ExpandPlusMinus::after {
    content: "" !important;
    position: absolute !important;
    width: 18px !important;
    height: 18px !important;
    margin-top: 3px !important;
    margin-left: 4px !important;
    transition: .25s ease-out !important;
    -webkit-mask-image: url(data:image/png;base64,) !important;
    -webkit-mask-repeat: no-repeat !important;
    -webkit-mask-size: contain !important;
    -webkit-mask-position: center !important;
    background-color: #c5d6d4 !important;
}

